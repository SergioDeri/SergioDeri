---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.webp";
import { site } from "../data/site";
import Asanoha from "./Asanoha.astro";

const greeting = `Hi, I'm ${site.name}`;
const words = greeting.split(" ").map((word, wordIndex, all) => {
  const before = all.slice(0, wordIndex).join("").length;
  return [...word].map((char, charIndex) => ({ char, index: before + charIndex }));
});
---

<section id="top" class="relative">
  <div class="hero-glow"></div>
  <div class="shell flex flex-col justify-between gap-2 pt-1 md:gap-4 md:pt-20 lg:gap-10 lg:flex-row lg:items-end">
    <div class="min-w-0 pb-6 lg:self-center lg:pb-16">
      <h1 class="text-[3rem] leading-none font-bold tracking-[-0.03em] lg:text-[4.5rem]">
          <span class="sr-only">{greeting}</span>
          <span aria-hidden="true">
            {
              words.map((letters, wordIndex) => (
                <>
                  {wordIndex > 0 && " "}
                  <span class="inline-block whitespace-nowrap">
                    {letters.map(({ char, index }) => (
                      <span class="letter" style={`--i:${index}`}>
                        {char}
                      </span>
                    ))}
                    {wordIndex === words.length - 1 && <span class="cursor" />}
                  </span>
                </>
              ))
            }
          </span>
        </h1>

      <p class="mt-4 text-[1.75rem] leading-tight font-semibold text-magenta md:mt-10 md:text-4xl">{site.role}</p>
      <p class="mt-3 max-w-[36rem] md:mt-5 text-pretty text-ink">{site.intro}</p>
      <Asanoha width={342} height={64} band class="mt-8 h-16 w-full lg:hidden" />
      <p class="mt-8 font-mono text-sm break-words text-muted lg:mt-10" aria-hidden="true">
        <span class="text-cyan">INVITE</span> sip:sergio@localhost SIP/2.0
      </p>
    </div>

    <div class="relative order-first mx-auto w-[min(62%,23svh)] max-w-[24rem] md:w-[82%] shrink-0 lg:order-none lg:mx-0 lg:w-[29rem] lg:max-w-none">
      <div class="portrait-fade relative"><div class="portrait relative" style={`--cutout: url(${portrait.src})`}>
        <Image
          src={portrait}
          alt="Portrait of Sergio Deri, smiling with arms crossed"
          widths={[320, 470]}
          sizes="(min-width: 64rem) 29rem, (min-width: 48rem) 82vw, 62vw"
          loading="eager"
          fetchpriority="high"
          class="block h-auto w-full"
        />
      </div></div>
    </div>
  </div>
</section>
