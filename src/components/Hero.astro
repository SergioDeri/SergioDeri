---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.webp";
import { site } from "../data/site";
import Asanoha from "./Asanoha.astro";
import NeonSign from "./NeonSign.astro";

const greeting = `Hi, I'm ${site.name}`;
const words = greeting.split(" ").map((word, wordIndex, all) => {
  const before = all.slice(0, wordIndex).join("").length;
  return [...word].map((char, charIndex) => ({ char, index: before + charIndex }));
});
---

<section id="top" class="relative">
  <div class="hero-glow"></div>
  <div class="shell flex items-stretch justify-between gap-12 pt-14 pb-20 md:pt-24 md:pb-28">
    <div class="min-w-0">
      <div class="flex items-center gap-4 md:gap-8">
        <div class="scanlines shrink-0 overflow-hidden rounded-lg border border-magenta/60">
          <Image
            src={avatar}
            alt="Portrait of Sergio Deri, smiling"
            widths={[96, 200, 400]}
            sizes="(min-width: 48rem) 200px, 96px"
            loading="eager"
            class="size-24 md:size-50"
          />
        </div>
        <h1 class="text-[3rem] leading-none font-bold tracking-[-0.03em] lg:text-[4.5rem]">
          <span class="sr-only">{greeting}</span>
          <span aria-hidden="true">
            {
              words.map((letters, wordIndex) => (
                <>
                  {wordIndex > 0 && " "}
                  <span class="inline-block whitespace-nowrap">
                    {letters.map(({ char, index }) => (
                      <span class="letter" style={`--i:${index}`}>
                        {char}
                      </span>
                    ))}
                    {wordIndex === words.length - 1 && <span class="cursor" />}
                  </span>
                </>
              ))
            }
          </span>
        </h1>
      </div>

      <p class="mt-10 text-[1.75rem] leading-tight font-semibold text-magenta md:text-4xl">{site.role}</p>
      <p class="mt-5 max-w-[36rem] text-pretty text-ink">{site.intro}</p>
      <Asanoha width={342} height={64} band class="mt-8 h-16 w-full lg:hidden" />
      <p class="mt-8 font-mono text-sm break-words text-muted lg:mt-10" aria-hidden="true">
        <span class="text-cyan">INVITE</span> sip:sergio@localhost SIP/2.0
      </p>
    </div>

    <div class="hidden w-[132px] shrink-0 self-center lg:block"><NeonSign /></div>
  </div>
</section>
