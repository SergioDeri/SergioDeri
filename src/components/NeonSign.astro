---
import { asanohaPath } from "../lib/patterns";

const lattice = asanohaPath(132, 452, 33);
---

<svg viewBox="0 0 132 460" class="neon-sign block h-auto w-full" fill="none" aria-hidden="true">
  <defs>
    <clipPath id="sign-panel"><rect x="10" y="4" width="112" height="452" rx="8"></rect></clipPath>
    <linearGradient id="sign-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0.34"></stop>
    </linearGradient>
    <mask id="sign-mask"><rect width="132" height="460" fill="url(#sign-fade)"></rect></mask>
  </defs>
  <g mask="url(#sign-mask)">
    <path d={lattice} clip-path="url(#sign-panel)" stroke="#5FEBFF" stroke-opacity="0.66" stroke-width="0.7"></path>
    <rect x="10" y="4" width="112" height="452" rx="8" stroke="#FF6BB5" stroke-width="1.5"></rect>
  </g>
</svg>

<style>
  .neon-sign {
    filter: drop-shadow(0 0 7px rgb(255 107 181 / 0.3));
  }
</style>
