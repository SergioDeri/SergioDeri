---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.webp";
import { navigation, site } from "../data/site";
import SocialLinks from "./SocialLinks.astro";
---

<header class="header-fade sticky top-0 z-40">
  <div class="shell grid grid-cols-[1fr_auto] items-center gap-x-4 py-2 md:grid-cols-[1fr_auto_1fr]">
    <a href="#top" class="flex w-fit items-center gap-3 font-mono text-sm text-ink">
      <Image src={avatar} alt="" width={36} height={36} densities={[1, 2]} class="size-9 rounded-lg" />
      {site.brand}
    </a>

    <nav aria-label="Main" class="order-3 col-span-2 md:order-none md:col-span-1">
      <ul class="flex justify-between gap-6 pb-1 text-base md:justify-center md:gap-9 md:pb-0">
        {
          navigation.map((item) => (
            <li>
              <a class="nav-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center justify-end gap-1 md:gap-3">
      <div class="hidden md:block"><SocialLinks /></div>
      <a
        href="#contact"
        class="button rounded-full bg-cyan px-4 py-2 text-sm font-semibold whitespace-nowrap text-void">Contact me</a
      >
    </div>
  </div>
</header>
