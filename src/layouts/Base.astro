---
import "../styles/global.css";
import { site } from "../data/site";
import Loader from "../components/Loader.astro";

const title = `${site.fullName} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL("/og.png", site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.fullName}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      if ("IntersectionObserver" in window) document.documentElement.classList.add("js");
      // Cover the page until Loader.astro opens the curtains. If that script never runs,
      // uncover it anyway so the visitor is not left in front of a black screen.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("loading");
        // The curtain opens on the top of the page, not wherever a reload left it.
        if (!location.hash) {
          history.scrollRestoration = "manual";
          scrollTo(0, 0);
        }
        setTimeout(() => document.documentElement.classList.remove("loading"), 6000);
      }
    </script>
  </head>
  <body>
    <Loader />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-cyan focus:px-4 focus:py-2 focus:text-void"
      >Skip to content</a
    >
    <div class="content">
      <slot />
    </div>
    <script>
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((element) => reveal.observe(element));

      const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav-link")];
      const spy = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const link of links) {
              if (link.hash === `#${entry.target.id}`) link.setAttribute("aria-current", "true");
              else link.removeAttribute("aria-current");
            }
          }
        },
        { rootMargin: "-45% 0px -50% 0px" },
      );
      document.querySelectorAll("main > [id]").forEach((section) => spy.observe(section));
    </script>
  </body>
</html>
